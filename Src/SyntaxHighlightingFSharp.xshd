<?xml version="1.0" ?> <!--encoding="UTF-8" -->
<SyntaxDefinition name = "F#" extensions = ".fs;.fsi;.fsx" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">

  <!--
  http://avalonedit.net/documentation/html/4d4ceb51-154d-43f0-b876-ad9640c5d2d8.htm

  copied and adapted from
  https://github.com/icsharpcode/AvalonEdit/tree/master/ICSharpCode.AvalonEdit/Highlighting/Resources
  https://github.com/icsharpcode/SharpDevelop/wiki/XSHD-Tags
  https://github.com/icsharpcode/SharpDevelop/wiki/Syntax-highlighting
  The named colors 'Comment' and 'String' are also used in SharpDevelop to detect if a line is inside a multiline string/comment

  AvalonEditB supports all named System.Windows.FontWeights, (while the original SharpDevelop.AvalonEdit only supports normal and bold.)
  see schema https://github.com/goswinr/AvalonEditB/blob/main/AvalonEditB/Highlighting/Resources/ModeV2.xsd
  -->

  <!--
  use this extension to show colors in vs code:
  https://marketplace.visualstudio.com/items?itemName=kamikillerto.vscode-colorize

  Dark theme:
  Any attribute can have a version for the dark theme, prefixed with 'dark', e.g. darkForeground, darkBackground or darkFontWeight.
  In the dark theme Fesh uses it instead of the original attribute.
  Fesh removes all these 'dark...' attributes before loading this file, they are not part of the xshd schema.
  The dark colors are based on F# in the Dark+ theme of VS Code, with the semantic highlighting of the Ionide extension.
  Where the light theme has more distinctions than VS Code, the dark theme has them too, with shades of the VS Code colors.
  -->
  <Color name="Comment"           foreground="#777777" darkForeground="#6A9955" fontWeight="300" fontStyle="italic" stylisticSet1="true"/>
  <Color name="DocComment"          foreground="#009900" darkForeground="#8CC57E" fontWeight="400" fontStyle="italic" stylisticSet1="true"/>
  <Color name="BracketComment"      foreground="#555555" darkForeground="#B5CEA8" fontWeight="800" fontStyle="italic" stylisticSet1="true"/>
  <Color name="TODO"                foreground="#EE0000" darkForeground="#FF5050" fontWeight="800"/>
  <Color name="HACK"                foreground="#A0A000" darkForeground="#D7D750" fontWeight="800"/>

  <Color name="String"              foreground="#BB1111" darkForeground="#CE9178" />
  <Color name="StringQuote"         foreground="#E08070" darkForeground="#A1715E" />
  <Color name="StringVerbatim"      foreground="#CC0000" darkForeground="#DBA088" />
  <Color name="StringFormatting"    foreground="#990099" darkForeground="#569CD6" />
  <Color name="StringEscaped"       foreground="#A050CC" darkForeground="#569CD6" />
  <Color name="CodeInString"        foreground="#50C030" darkForeground="#73C991" />
  <Color name="DollarInlines"       foreground="#000088" darkForeground="#B8C4F0" />
  <Color name="Char"                foreground="#FF0040" darkForeground="#D16969" />

  <Color name="CompilerDirectives"  foreground="#FF8800" darkForeground="#E8A35C" /> <!-- eg: #if COMPILED-->

  <Color name="LoadDirectives"      foreground="#BB1111" darkForeground="#CE9178" /> <!-- the #r or #load or #I-->
  <Color name="LoadDllPath"         foreground="#778899" darkForeground="#8A99A8" /> <!-- #r the directory path including the quotes-->
  <Color name="LoadDll"             foreground="#DD20B0" darkForeground="#E36BC8" /> <!-- #r the dll name -->
  <Color name="LoadNuget"           foreground="#CD10A0" darkForeground="#DA70D6" fontWeight="bold" /> <!-- #r the nuget name -->
  <Color name="LoadPath"            foreground="#0000B0" darkForeground="#7FA8F0" /> <!-- for #I path -->

  <Color name="Punctuation"         foreground="#8855FF" darkForeground="#8C9EEB" />
  <Color name="Attributes"          foreground="#AA88AA" darkForeground="#B898B8" />
  <Color name="Keywords"            foreground="#0000DD" darkForeground="#569CD6"  fontWeight="normal" fontStyle="italic"  stylisticSet1="true"/>
  <Color name="KeywordsBang"        foreground="#2200DD" darkForeground="#5E9EE0"  fontWeight="bold"   fontStyle="italic"  stylisticSet1="true"/>
  <Color name="Keywords2"           foreground="#BB0044" darkForeground="#EF7A8F"  fontWeight="bold"   fontStyle="italic"  stylisticSet1="true"/>
  <Color name="Keywords2Bang"       foreground="#BB0044" darkForeground="#EF7A8F"  fontWeight="bold"   fontStyle="italic"  stylisticSet1="true"/>
  <!-- the control flow keywords, in the light theme the same as the keywords above: -->
  <Color name="KeywordsControl"     foreground="#0000DD" darkForeground="#C586C0"  fontWeight="normal" fontStyle="italic"  stylisticSet1="true"/>
  <Color name="KeywordsBangControl" foreground="#2200DD" darkForeground="#CC8ECA"  fontWeight="bold"   fontStyle="italic"  stylisticSet1="true"/>
  <Color name="Keywords2Control"    foreground="#BB0044" darkForeground="#EF7A8F"  fontWeight="bold"   fontStyle="italic"  stylisticSet1="true"/>
  <!-- mutability: the mutable keyword and the assignment arrow have the color of the mutable values. Semantic.MutableVar and Semantic.MutableRecordField are underlined too -->
  <Color name="KeywordsMutable"     foreground="#C6910C" darkForeground="#FFAF5F"  fontWeight="normal" fontStyle="italic"  stylisticSet1="true"/>
  <Color name="Assignment"          foreground="#C6910C" darkForeground="#FFAF5F" /> <!-- the <- arrow -->
  <Color name="ReservedKeywords"    foreground="#7777FF" darkForeground="#569CD6" /> <!-- fontWeight="bold" -->
  <Color name="MethodCall"          foreground="#0000AA" darkForeground="#DCDCAA" /> <!-- fontWeight="bold" fontStyle="italic"-->
  <Color name="NumberLiteral"       foreground="#CD10A0" darkForeground="#B5CEA8" />
  <Color name="NegNumberLiteral"    foreground="#df78a8" darkForeground="#93AB86" /> <!--fontWeight="bold" -->
  <Color name="ExponentNumberLit"   foreground="#1199DD" darkForeground="#6CB6E0" />
  <Color name="HexNumberLiteral"    foreground="#FF8800" darkForeground="#E8A35C" />
  <Color name="BinNumberLiteral"    foreground="#FF8800" darkForeground="#E8A35C" />
  <Color name="NumberType"          foreground="#888888" darkForeground="#8A8A8A" />
  <Color name="FailStatement"       foreground="#888888" darkForeground="#8A8A8A" />
  <Color name="FailString"          foreground="#D0A040" darkForeground="#D7BA7D" fontWeight="normal" fontStyle="italic" />
  <Color name="Exception"           foreground="#C06030" darkForeground="#E0885A" />
  <Color name="PrintStatement"      foreground="#206060" darkForeground="#70A8A0" />
  <Color name="PrintString"         foreground="#E08070" darkForeground="#A1715E" />
  <Color name="TrueCol"             foreground="#008090" darkForeground="#4FD1D9" fontWeight="800" fontStyle="italic" />
  <Color name="FalseCol"            foreground="#A70090" darkForeground="#E07CC8" fontWeight="800" fontStyle="italic" />
  <Color name="Semicolon"           foreground="#A0A0A0" darkForeground="#707070" />
  <Color name="EscapeSlash"         foreground="#CCCCCC" darkForeground="#484848" />
  <!--
  <Color name="TypeAnnotation"      foreground="#2080B0" darkForeground="#5FA8D8" />
  <Color name="RecordNames"         foreground="#B06000" darkForeground="#E09040" />
  <Color name="LetBinding"          foreground="#7030A0" darkForeground="#B080E0" />
  <Color name="LetPrivate"          foreground="#6070A0" darkForeground="#90A0D0" />
  <Color name="LetRec"              foreground="#B03080" darkForeground="#E070B0" />
  <Color name="LetMutable"          foreground="#D08030" darkForeground="#E8A860" />
  -->
  <Color name="InDoubleTicks"       foreground="#000000" darkForeground="#D4D4D4" /><!-- just black like the rest, don't highlight symbols-->

  <Color name="DocCommentStart"     foreground="#CCCCCC" darkForeground="#505050" /> <!-- taken from https://github.com/icsharpcode/AvalonEdit/blob/master/ICSharpCode.AvalonEdit/Highlighting/Resources/XmlDoc.xshd-->
  <Color name="XmlString"           foreground="#EE3333" darkForeground="#CE9178" />
  <Color name="XmlPunctuation"      foreground="#888888" darkForeground="#808080" />
  <Color name="KnownDocTags"        foreground="#8888EE" darkForeground="#569CD6" />

  <Color name="NonEval"             foreground="#CCCCCC" darkForeground="#484848" />

  <!--
  Semantic highlighting:
  These colors are not used by the rules in this file, but by the semantic highlighting from the F# compiler service.
  It is applied on top of the highlighting from this file, once the type check has finished.
  The names are 'Semantic.' + the case name of FSharp.Compiler.EditorServices.SemanticClassificationType.
  Only foreground, background, fontWeight="bold", fontStyle="italic" and underline="true" are used.
  'Semantic.Unused' and 'Semantic.BadIndent' are not from the compiler service, they mark unused declarations and indents that are not a multiple of the indentation size.
  -->
  <Color name="Semantic.ReferenceType"                foreground="#8B0049" darkForeground="#4EC9B0" />
  <Color name="Semantic.ValueType"                    foreground="#922DAB" darkForeground="#83C691" />
  <Color name="Semantic.UnionCase"                    foreground="#236A96" darkForeground="#4FC1FF" />
  <Color name="Semantic.UnionCaseField"               foreground="#236A96" darkForeground="#4FC1FF" />
  <Color name="Semantic.Function"                     foreground="#905E00" darkForeground="#DCDCAA" />
  <Color name="Semantic.Property"                     foreground="#006063" darkForeground="#98E2E2" />
  <Color name="Semantic.MutableVar"                   foreground="#C6910C" darkForeground="#FFAF5F" /> <!-- underline="true" -->
  <Color name="Semantic.Module"                       foreground="#000000" darkForeground="#D4D4D4" />
  <Color name="Semantic.Namespace"                    foreground="#000000" darkForeground="#D4D4D4" />
  <Color name="Semantic.ComputationExpression"        foreground="#4B0082" darkForeground="#D19AE8" />
  <Color name="Semantic.IntrinsicFunction"            foreground="#00008B" darkForeground="#6E8CFF" />
  <Color name="Semantic.Enumeration"                  foreground="#4B0082" darkForeground="#D19AE8" />
  <Color name="Semantic.Interface"                    foreground="#B30171" darkForeground="#B7D7A3" />
  <Color name="Semantic.TypeArgument"                 foreground="#6A5ACD" darkForeground="#9AB8F0" />
  <Color name="Semantic.Operator"                     foreground="#7B68EE" darkForeground="#B4A7F5" />
  <Color name="Semantic.DisposableType"               foreground="#9932CC" darkForeground="#A98BFF" />
  <Color name="Semantic.DisposableTopLevelValue"      foreground="#9932CC" darkForeground="#A98BFF" />
  <Color name="Semantic.DisposableLocalValue"         foreground="#9932CC" darkForeground="#A98BFF" />
  <Color name="Semantic.Method"                       foreground="#009295" darkForeground="#E4BD79" />
  <Color name="Semantic.ExtensionMethod"              foreground="#00B0B3" darkForeground="#F2DA8E" />
  <Color name="Semantic.ConstructorForReferenceType"  foreground="#A52A2A" darkForeground="#2E9E86" />
  <Color name="Semantic.ConstructorForValueType"      foreground="#A45410" darkForeground="#5FA868" />
  <Color name="Semantic.Literal"                      foreground="#2E8B57" darkForeground="#53E0A0" />
  <Color name="Semantic.RecordField"                  foreground="#254545" darkForeground="#ABCDCD" />
  <Color name="Semantic.MutableRecordField"           foreground="#C6910C" darkForeground="#FFAF5F" /> <!-- underline="true" -->
  <Color name="Semantic.RecordFieldAsFunction"        foreground="#DDA0DD" darkForeground="#F0C0D8" />
  <Color name="Semantic.Exception"                    foreground="#D7418C" darkForeground="#E88AB8" />
  <Color name="Semantic.Field"                        foreground="#9370DB" darkForeground="#C8B8F0" />
  <Color name="Semantic.Event"                        foreground="#808000" darkForeground="#C8C269" />
  <Color name="Semantic.Delegate"                     foreground="#556B2F" darkForeground="#8FB860" />
  <Color name="Semantic.NamedArgument"                foreground="#8B2043" darkForeground="#F0A8A0" />
  <Color name="Semantic.Value"                        foreground="#770000" darkForeground="#9CDCFE" />
  <Color name="Semantic.LocalValue"                   foreground="#630000" darkForeground="#B7E6FF" />
  <Color name="Semantic.Type"                         foreground="#9F005D" darkForeground="#7EE0C8" />
  <Color name="Semantic.TypeDef"                      foreground="#800080" darkForeground="#2BB7C9" />
  <Color name="Semantic.Plaintext"                    foreground="#C30900" darkForeground="#F44747" />
  <Color name="Semantic.Unused"                       foreground="#A8A8A8" darkForeground="#6A6A6A" fontWeight="bold" />
  <Color name="Semantic.BadIndent"                    background="#28FFB400" darkBackground="#30FFB400" /> <!-- transparent to show the column rulers behind -->

  <!--
  Colors of the code editor and of the Log window:
  These are not used for highlighting text, Fesh reads them from this file. They update when this file is reloaded.
  The color is the foreground attribute. If there is no foreground attribute the background attribute is the color.
  Only 'Editor.Selection' is optional, if it is missing AvalonEdit's default selection color is used.
  Colors can have an alpha value, e.g. #28FFB400
  -->
  <Color name="Editor.Background"                 background="#FFFFFF" darkBackground="#121212" />
  <Color name="Editor.Foreground"                 foreground="#000000" darkForeground="#D4D4D4" /> <!-- text that no rule colors -->
  <Color name="Editor.CurrentLine"                background="#F6FFFF" darkBackground="#1f1f1f" />
  <Color name="Editor.Link"                       foreground="#006400" darkForeground="#5DBB63" />
  <Color name="Editor.Margin"                     background="#F7F7F7" darkBackground="#151515" /> <!-- the line number and folding margin -->
  <Color name="Editor.LineNumbers"                foreground="#C0C0C0" darkForeground="#555" />
  <Color name="Editor.CurrentLineNumber"          foreground="#000000" darkForeground="#EEEEEE" /> <!-- the line with the caret -->
  <Color name="Editor.ColumnRuler"                foreground="#E7E7E7" darkForeground="#383838" /> <!-- the first ruler, the following ones fade out -->
  <Color name="Editor.FoldingMarker"              foreground="#808080" darkForeground="#808080" />
  <Color name="Editor.FoldingMarkerBg"            background="#FFFFFF" darkBackground="#252526" />
  <Color name="Editor.FoldingMarkerSelected"      foreground="#000000" darkForeground="#D4D4D4" />
  <Color name="Editor.FoldingMarkerSelectedBg"    background="#FFFFFF" darkBackground="#252526" />
  <Color name="Editor.SearchMarker"               background="#90EE90" darkBackground="#3B5E3B" /> <!-- results of the search panel (Ctrl + F) -->
  <Color name="Editor.Selection"                                       darkBackground="#264F78" /> <!-- no light color, to use the default of AvalonEdit -->
  <Color name="Editor.SelectionHighlight"         background="#CDFFFF" darkBackground="#234B50" /> <!-- all other occurrences of the selected word -->
  <Color name="Editor.EvaluatedBg"                background="#EEEEEE" darkBackground="#2A2A2A" /> <!-- the code that was evaluated in FSI already -->
  <Color name="Editor.EvaluatedBorder"            foreground="#6C6C6C" darkForeground="#505050" />
  <Color name="Editor.BracketPair"                background="#A0FFA0" darkBackground="#2D5A2D" /> <!-- the matching brackets at the caret -->
  <Color name="Editor.BracketError"               foreground="#FF0000" darkForeground="#FF5050" />
  <Color name="Editor.BracketErrorBg"             background="#5AFF9600" darkBackground="#6EC85A00" />
  <Color name="Editor.BracketNesting1"            foreground="#A828A8" darkForeground="#FFD700" /> <!-- the colors of nested brackets. The outermost brackets have the Punctuation color -->
  <Color name="Editor.BracketNesting2"            foreground="#E18700" darkForeground="#DA70D6" />
  <Color name="Editor.BracketNesting3"            foreground="#1E9E1E" darkForeground="#179FFF" />
  <Color name="Editor.BracketNesting4"            foreground="#00D7D7" darkForeground="#FFD700" />

  <Color name="Log.Background"                    background="#FFFFFF" darkBackground="#1B1B1C" />
  <Color name="Log.Foreground"                    foreground="#000000" darkForeground="#D4D4D4" />
  <Color name="Log.Link"                          foreground="#0000FF" darkForeground="#4FA3FF" />
  <Color name="Log.Border"                        foreground="#000000" darkForeground="#3F3F46" />
  <Color name="Log.SelectionHighlight"            background="#DCDCFF" darkBackground="#2E2E5E" /> <!-- all other occurrences of the selected word -->
  <Color name="Log.Margin"                        background="#FFFFFF" darkBackground="#1B1B1C" /> <!-- the line number margin -->
  <Color name="Log.LineNumbers"                   foreground="#C0C0C0" darkForeground="#555" />


  <!-- ReExes that are listed higher have precedence of lower positions in this list
  Spans are overwriting rules even if rule appears before the span!-->

  <RuleSet name="_DocCommentSet">
    <Span color="DocComment">
      <Begin color="XmlPunctuation">&lt;</Begin>
      <End color="XmlPunctuation">&gt;</End>
      <RuleSet>
        <Span color="XmlString">
          <Begin>"</Begin>
          <End>"</End>
        </Span>
        <Keywords color="XmlPunctuation">
          <Word>/</Word>
          <Word>|</Word>
          <Word>=</Word>
        </Keywords>
        <Keywords color="KnownDocTags">
          <Word>c</Word>
          <Word>code</Word>
          <Word>example</Word>
          <Word>exception</Word>
          <Word>list</Word>
          <Word>para</Word>
          <Word>param</Word>
          <Word>paramref</Word>
          <Word>permission</Word>
          <Word>remarks</Word>
          <Word>returns</Word>
          <Word>see</Word>
          <Word>seealso</Word>
          <Word>summary</Word>
          <Word>value</Word>
          <Word>type</Word>
          <Word>name</Word>
          <Word>cref</Word>
          <Word>item</Word>
          <Word>term</Word>
          <Word>description</Word>
          <Word>listheader</Word>
          <Word>typeparam</Word>
          <Word>typeparamref</Word>
        </Keywords>
      </RuleSet>
    </Span>
  </RuleSet>

  <RuleSet name="_CommentMarkerSet">
    <Keywords color="TODO">
      <Word>TODO</Word>
      <Word>FIXME</Word>
      <Word>??</Word>
      <Word>!!</Word>
    </Keywords>
    <Keywords color="HACK">
      <Word>HACK</Word>
      <Word>UNDONE</Word>
    </Keywords>
    <Rule color="BracketComment">\([\d\.]+\)</Rule>
  </RuleSet >

  <RuleSet name="CommentSet">

    <Span color="DocComment">
      <Begin color="DocCommentStart">///(?!/)</Begin>
      <RuleSet>
        <Import ruleSet="_DocCommentSet"/>
        <Import ruleSet="_CommentMarkerSet"/>
      </RuleSet>
    </Span>

    <Span color="Comment" ruleSet="_CommentMarkerSet">
      <Begin>//</Begin>
    </Span>

  </RuleSet >

  <RuleSet name="InlineCommentSet">
    <Span color="Comment" ruleSet="_CommentMarkerSet" multiline="true">
      <Begin>\(\*</Begin>
      <End>\*\)</End>
    </Span>
  </RuleSet >

  <RuleSet name="KeywordSet">
    <Keywords color="TrueCol">    <Word>true</Word>    </Keywords>
    <Keywords color="FalseCol">   <Word>false</Word>   </Keywords>

    <Rule color="KeywordsBangControl">match!</Rule> <!-- because exclamation mark does not work in <Word> tag -->
    <Rule color="KeywordsBang">let!</Rule>
    <Rule color="KeywordsBangControl">do!</Rule>
    <Rule color="Keywords2Bang">yield!</Rule>
    <Rule color="Keywords2Bang">return!</Rule>
    <Rule color="Keywords2Bang">use!</Rule>


    <Keywords color="Keywords2Control">
      <Word>yield</Word>
      <Word>return</Word>
    </Keywords>

    <Keywords color="Keywords2">
      <Word>rec</Word>
      <Word>and</Word>
    </Keywords>

    <Keywords color="KeywordsMutable">
      <Word>mutable</Word>
    </Keywords>

    <Keywords color="KeywordsControl">
      <Word>do</Word>
      <Word>elif</Word>
      <Word>else</Word>
      <Word>finally</Word>
      <Word>for</Word>
      <Word>if</Word>
      <Word>in</Word>
      <Word>match</Word>
      <Word>then</Word>
      <Word>try</Word>
      <Word>while</Word>
      <Word>with</Word>
    </Keywords>

    <Keywords color="Keywords">

      <Word>__SOURCE_DIRECTORY__</Word>
      <Word>__SOURCE_FILE__</Word>
      <Word>__LINE__</Word>
      <!-- take from https://github.com/Microsoft/visualfsharp/blob/f214dcc38f6d34db8902eb40bd5b037ade59a67c/src/fsharp/lexhelp.fs#L362 -->
      <Word>abstract</Word>
      <Word>as</Word>
      <Word>assert</Word>
      <Word>base</Word>
      <Word>begin</Word>
      <Word>class</Word>
      <Word>default</Word>
      <Word>delegate</Word>
      <Word>done</Word>
      <Word>downcast</Word>
      <Word>downto</Word>
      <Word>end</Word>
      <Word>exception</Word>
      <Word>extern</Word>
      <!-- <Word>FALSE</Word> -->
      <Word>fixed</Word>
      <Word>fun</Word>
      <Word>function</Word>
      <Word>global</Word>
      <Word>inherit</Word>
      <Word>inline</Word>
      <Word>interface</Word>
      <Word>internal</Word>
      <Word>lazy</Word>
      <Word>let</Word>
      <Word>member</Word>
      <Word>module</Word>
      <Word>namespace</Word>
      <Word>new</Word>
      <Word>not</Word>
      <Word>null</Word>
      <Word>of</Word>
      <Word>open</Word>
      <Word>or</Word>
      <Word>override</Word>
      <Word>private</Word>
      <Word>public</Word>
      <Word>select</Word>
      <Word>static</Word>
      <Word>struct</Word>
      <Word>to</Word>
      <!-- <Word>TRUE</Word> -->
      <Word>typeof</Word>
      <Word>type</Word>
      <Word>upcast</Word>
      <Word>use</Word>
      <Word>val</Word>
      <Word>void</Word>
      <Word>when</Word>
    </Keywords>

    <!-- exclude for now to keep highlighting rules faster
    <Keywords color = "ReservedKeywords">
      <Word>atomic</Word>
      <Word>break</Word>
      <Word>checked</Word>
      <Word>component</Word>
      <Word>const</Word>
      <Word>constraint</Word>
      <Word>constructor</Word>
      <Word>continue</Word>
      <Word>eager</Word>
      <Word>event</Word>
      <Word>external</Word>
      <Word>fixed</Word>
      <Word>functor</Word>
      <Word>include</Word>
      <Word>method</Word>
      <Word>mixin</Word>
      <Word>object</Word>
      <Word>parallel</Word>
      <Word>process</Word>
      <Word>protected</Word>
      <Word>pure</Word>
      <Word>sealed</Word>
      <Word>tailcall</Word>
      <Word>trait</Word>
      <Word>virtual</Word>
      <Word>volatile</Word>
    </Keywords>
    -->

  </RuleSet>

  <RuleSet name="_StringEscapeSet">
    <!-- (?=") is a positive lookahead for "   -->
    <Span> <Begin color="EscapeSlash">\\(?=")</Begin> <End color="String">"</End> </Span>
    <Span> <Begin color="EscapeSlash">\\(?=')</Begin> <End color="String">'</End> </Span>
    <Span> <Begin color="EscapeSlash">\\(?=\\)</Begin> <End color="String">\\</End> </Span>

    <!-- using just a Rule does not work !-->
    <!-- https://docs.microsoft.com/en-us/dotnet/fsharp/language-reference/strings -->
    <Span color="StringEscaped"><Begin>\\[abfnrtv]  </Begin>  <End>(?=.)</End> </Span>
    <!-- unicode characters  -->
    <Span color="StringEscaped"><Begin>\\[\d]{3}        </Begin>  <End>(?=.)</End> </Span>
    <Span color="StringEscaped"><Begin>\\U[0-9a-fA-F]{8}</Begin>  <End>(?=.)</End> </Span>
    <Span color="StringEscaped"><Begin>\\u[0-9a-fA-F]{4}</Begin>  <End>(?=.)</End> </Span>
    <Span color="StringEscaped"><Begin>\\x[0-9a-fA-F]{2}</Begin>  <End>(?=.)</End> </Span>
  </RuleSet >

  <RuleSet name="_StringFormatSet">
    <Span color="StringEscaped"><Begin>%</Begin> <End>[sfd%bciuxXoeEfFgGeEgGMOAAat]</End> </Span>
  </RuleSet >

  <RuleSet name="_StringDollarFormatSet">
    <!-- mak sure a {{ and a }} is not considered a code in string , and highlight the outer ones as escaped: -->
    <Span> <Begin color="StringEscaped">\{(?=\{)</Begin><End>\{</End></Span>
    <Span> <Begin>\}(?=\})</Begin><End color="StringEscaped">\}</End></Span>
    <Import ruleSet="_StringFormatSet"/>
    <Span color="DollarInlines">
      <Begin color="CodeInString">\{</Begin>
      <End color="CodeInString">\}</End>
    </Span>
  </RuleSet >

  <RuleSet name="_StringDoubleDollarFormatSet">
    <Import ruleSet="_StringFormatSet"/>
    <Span color="DollarInlines">
      <Begin color="CodeInString">\{\{</Begin>
      <End color="CodeInString">\}\}</End>
    </Span>
  </RuleSet >

  <RuleSet name="LoadDllSet">

    <!-- compiler directives: -->
    <Span color="NonEval" multiline="true">
      <Begin color="CompilerDirectives">\#if\s*COMPILED </Begin> <!-- '#' needs to be escaped too, \#  it is a regex comment  -->
      <End color="CompilerDirectives">\#endif\b|\#else\b</End>
    </Span>

    <Span color="CompilerDirectives" multiline="false">
      <Begin color="CompilerDirectives">\#if\b </Begin> <!-- '#' needs to be escaped too, \#  it is a regex comment  -->
      <RuleSet>
        <Import ruleSet="CommentSet"/>
      </RuleSet >
    </Span>
    <Rule color="CompilerDirectives">\#endif\b</Rule>
    <Rule color="CompilerDirectives">\#else\b</Rule>

    <Span color="LoadDirectives" multiline="false">
      <Begin >\#r\b|\#load\b|\#nowarn\b </Begin> <!-- '#' needs to be escaped too, \#  it is a regex comment  -->
      <End>(?=(;;))</End> <!-- so that NonEval works -->
      <RuleSet>
        <Import ruleSet="CommentSet"/>

        <Span color="LoadNuget" multiline="false">
          <Begin color="LoadDllPath">"nuget:</Begin>
          <End color="LoadDllPath">"|(,.+")</End>
        </Span>
        <Span color="LoadDll" multiline="false">
          <Begin color="LoadDllPath">@?"[^\s\/][^"]+(\\|\/)|@?"(?=[^\s\/])</Begin>  <!--matches the directories part of a full file path-->
          <End color="LoadDllPath">"|(.dll")</End>
        </Span>
      </RuleSet >
    </Span>

    <Span color="LoadDirectives" multiline="false">
      <Begin>\#I\b</Begin>    <!-- In case of #I highlight the folder path with color="LoadDll" -->
      <End>(?=(;;))</End> <!-- so that NonEval works -->
      <RuleSet>
        <Import ruleSet="CommentSet"/>
        <Span color="LoadPath" multiline="false">
          <Begin color="LoadDllPath">@?"</Begin>
          <End color="LoadDllPath">"</End>
        </Span>
      </RuleSet >
    </Span>

  </RuleSet >

  <RuleSet name="StringSet">
    <Span color="Char" >
      <Begin>'(?=\\)|'.(?=')</Begin>  <!-- a ' followed by one or zero \ then any char and then another ' in look ahead-->
      <End>'</End>
      <RuleSet> <Import ruleSet="_StringEscapeSet"/> </RuleSet>
    </Span>

    <Span color="StringVerbatim" multiline="true">
      <Begin color="StringQuote">@"</Begin>
      <End color="StringQuote">"</End>
    </Span>

    <Span color="String" multiline="true">
      <Begin color="StringQuote">\$\$"""</Begin>
      <End color="StringQuote">"""</End>
      <RuleSet><Import ruleSet="_StringDoubleDollarFormatSet"/></RuleSet>
    </Span>

    <Span color="String" multiline="true">
      <Begin color="StringQuote">\$"""</Begin>
      <End color="StringQuote">"""</End>
      <RuleSet><Import ruleSet="_StringDollarFormatSet"/></RuleSet>
    </Span>

    <Span color="String" multiline="true">
      <Begin color="StringQuote">\$"</Begin>
      <End color="StringQuote">"</End>
      <RuleSet>
        <Import ruleSet="_StringDollarFormatSet"/>
        <Import ruleSet="_StringEscapeSet"/>
      </RuleSet>
    </Span>

    <Span color="StringVerbatim" multiline="true">
      <Begin color="StringQuote">"""</Begin>
      <End color="StringQuote">"""</End>
    </Span>

    <Span  color="String" multiline="true">
      <Begin color="StringQuote">"</Begin>
      <End color="StringQuote">"</End>
      <RuleSet><Import ruleSet="_StringEscapeSet"/> </RuleSet>
    </Span>
  </RuleSet>


  <RuleSet name="__PrintStr">
    <Span color="PrintString" multiline="true"><Begin color="PrintStatement">@"</Begin>     <End color="PrintStatement">"</End></Span>
    <Span color="PrintString" multiline="true"><Begin color="PrintStatement">"""</Begin>    <End color="PrintStatement">"""</End></Span>
    <Span color="PrintString" multiline="true"><Begin color="PrintStatement">\$\$"""</Begin><End color="PrintStatement">"""</End> <RuleSet><Import ruleSet="_StringDoubleDollarFormatSet"/></RuleSet></Span>
    <Span color="PrintString" multiline="true"><Begin color="PrintStatement">\$"""</Begin>  <End color="PrintStatement">"""</End> <RuleSet><Import ruleSet="_StringFormatSet"/><Import ruleSet="_StringDollarFormatSet"/></RuleSet></Span>
    <Span color="PrintString" multiline="true"><Begin color="PrintStatement">\$"</Begin>    <End color="PrintStatement">"</End>   <RuleSet><Import ruleSet="_StringFormatSet"/><Import ruleSet="_StringDollarFormatSet"/><Import ruleSet="_StringEscapeSet"/></RuleSet></Span>
    <Span color="PrintString" multiline="true"><Begin color="PrintStatement">"</Begin>      <End color="PrintStatement">"</End>   <RuleSet><Import ruleSet="_StringFormatSet"/><Import ruleSet="_StringEscapeSet"/></RuleSet></Span>
  </RuleSet>
  <RuleSet name="PrintingStringsSet" >
    <Span color="PrintStatement">
      <Begin>\bPrintfn?\.\w+\s+</Begin><End>(?&lt;=")</End> <!-- for Printfn.red and similar functions.--> <!-- (?<=") or  (?&lt;=") is a positive lookbehind for "  -->
      <RuleSet><Import ruleSet="__PrintStr"/></RuleSet>
    </Span>
    <Span color="PrintStatement">
      <Begin>\be?printfn?\s+</Begin><End>(?&lt;=")</End> <!-- for Printfn.red and similar functions.-->
      <RuleSet><Import ruleSet="__PrintStr"/></RuleSet>
    </Span>
  </RuleSet>

  <RuleSet name="__FailStr">
    <Span color="FailString" multiline="true"><Begin color="FailStatement">@"</Begin>     <End color="FailStatement">"</End></Span>
    <Span color="FailString" multiline="true"><Begin color="FailStatement">"""</Begin>    <End color="FailStatement">"""</End></Span>
    <Span color="FailString" multiline="true"><Begin color="FailStatement">\$\$"""</Begin><End color="FailStatement">"""</End> <RuleSet><Import ruleSet="_StringDoubleDollarFormatSet"/></RuleSet></Span>
    <Span color="FailString" multiline="true"><Begin color="FailStatement">\$"""</Begin>  <End color="FailStatement">"""</End> <RuleSet><Import ruleSet="_StringFormatSet"/><Import ruleSet="_StringDollarFormatSet"/></RuleSet></Span>
    <Span color="FailString" multiline="true"><Begin color="FailStatement">\$"</Begin>    <End color="FailStatement">"</End>   <RuleSet><Import ruleSet="_StringFormatSet"/><Import ruleSet="_StringDollarFormatSet"/><Import ruleSet="_StringEscapeSet"/></RuleSet></Span>
    <Span color="FailString" multiline="true"><Begin color="FailStatement">"</Begin>      <End color="FailStatement">"</End>   <RuleSet><Import ruleSet="_StringFormatSet"/><Import ruleSet="_StringEscapeSet"/></RuleSet></Span>
  </RuleSet>
  <RuleSet name="FailingStringsSet" >
    <Span color="FailStatement">
      <Begin>\bfailwithf?\s+</Begin><End>(?&lt;=")</End>  <!-- (?<=") or  (?&lt;=") is a positive lookbehind for "  -->
      <RuleSet><Import ruleSet="__FailStr"/></RuleSet>
    </Span>
  </RuleSet>

  <RuleSet name="PunctuationSet">
    <!-- the back and forward arrows : -->
    <Rule color="Punctuation">-&gt;</Rule>
    <Rule color="Assignment">&lt;-</Rule>

    <!-- any single character punctuation
     . $ ^ { [ ( | ) * + ? \ need escape
      but excluding math operators: -->
    <Rule color="Punctuation">[ \. \$ \^ \{ \[ \( \| \)  \? \\ &lt; &gt; &amp; , : \] \}  ~ !  % = ]</Rule>

    <Rule color="Semicolon">;</Rule>

    <!-- a hex number | binary number | (number just starting with floating point | with optional inner floating point) and an optional exponent. https://regexr.com/52d6q -->
    <!-- <Rule color="NumberLiteral">((-\.|\.)[0-9_]+|(\b|-)[0-9_]+\.?[0-9_]*)([eE][+-]?[0-9]+)? </Rule> -->
    <Rule color="ExponentNumberLit">\b0[xX]</Rule>
    <Rule color="ExponentNumberLit">\b0[bB]</Rule>
    <Rule color="HexNumberLiteral">(?&lt;=0[xX])[0-9a-fA-F_]+</Rule>
    <Rule color="BinNumberLiteral">(?&lt;=0[bB])[01_]+</Rule>
    <Rule color="ExponentNumberLit">(?&lt;=\d)[eE][+-]?[0-9]+ </Rule><!-- (?&lt;=\d) is a positive lookbehind for digits -->
    <Rule color="ExponentNumberLit">(?&lt;=\d)u[ysl] </Rule><!-- numeric literals suffixes https://learn.microsoft.com/en-us/dotnet/fsharp/language-reference/literals -->
    <Rule color="ExponentNumberLit">(?&lt;=\b\d+)[yslunLFfIMm] </Rule><!-- numeric literals suffixes https://learn.microsoft.com/en-us/dotnet/fsharp/language-reference/literals -->
    <Rule color="NumberLiteral">\b[0-9_]+\.?[0-9_]*</Rule>
    <!-- to exclude a 'x-1' to be highlighted as NegNumberLiteral below too: -->
    <Rule color="Punctuation">\b\-</Rule>
    <Rule color="NegNumberLiteral">(?&lt;!\d)-[0-9_]+\.?[0-9_]*</Rule> <!-- (?&lt;!\d) is a negative lookbehind for digits -->


    <Span color="NonEval" multiline="true" > <!--anything after a double semicolon is ignored in FSI-->
      <Begin>;;</Begin>
      <End>@@justAnyStringThatNeverHappens</End>
    </Span>

    <Span color="InDoubleTicks"  multiline="false" begin="``" end="``" />

  </RuleSet>

  <!--the main set (it must not have a name attribute): -->
  <RuleSet>

    <Span color="Attributes">
      <Begin color="Punctuation">\[&lt;</Begin>
      <End color="Punctuation">&gt;\]</End>
      <RuleSet>
        <Import ruleSet="StringSet"/>
        <Import ruleSet="PunctuationSet"/>
      </RuleSet>
    </Span>

    <Import ruleSet="LoadDllSet"/>
    <Import ruleSet="CommentSet"/>
    <Import ruleSet="InlineCommentSet"/>
    <Import ruleSet="StringSet"/>
    <Import ruleSet="KeywordSet"/>
    <Import ruleSet="PrintingStringsSet"/>
    <Import ruleSet="FailingStringsSet"/>
    <!-- import last: -->
    <Import ruleSet="PunctuationSet"/>
  </RuleSet>

</SyntaxDefinition>
