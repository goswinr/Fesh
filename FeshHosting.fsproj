<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- <OutputType>Library</OutputType> not needed -->

    <!-- Avalonia 12 needs net8.0 or higher, so there is no .NET Framework build anymore.
    The the releaseNuget.yml action replaces this line to publish nugets for other frameworks separately: -->
    <TargetFramework>net8.0</TargetFramework> <!-- use the lowest F# here by default, will be replace by other versions in releaseNuget.yml -->

    <!-- StartsWith so that 'net8.0' and 'net8.0-windows' both work -->
    <DefineConstants Condition="$(TargetFramework.StartsWith('net8.0'))">NET8</DefineConstants> <!-- so that caret in GetProjectOptionsFromScript can be skipped-->

    <LangVersion>preview</LangVersion><!-- to enable indexing from end via ^ -->

    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>  <!--to only have the English resources-->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>	 <!-- does not work when used in visual studio? only dotnet sdk ?-->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference> <!-- for dotnet outdated tool to work, so use Include not Update for FSharp.Core -->

    <RootNamespace>Fesh</RootNamespace>
    <AssemblyName>Fesh</AssemblyName>
    <AssemblyTitle>Fesh</AssemblyTitle>
    <Title>Fesh</Title>
    <Product>Fesh</Product>
    <PackageId>Fesh</PackageId>

    <!-- <Version></Version> done by Ionide.KeepAChangelog.Tasks -->

    <Authors>Goswin Rothenthal</Authors>
    <Copyright>Goswin Rothenthal 2019</Copyright>
    <Description>A hostable cross-platform scripting editor for F#, based on AvaloniaEdit</Description>
    <ApplicationIcon>Media/logo.ico</ApplicationIcon>
    <Win32Resource>Media/logo.res</Win32Resource>    <!-- Win32Resource for Application Icon in explorer-->

    <OtherFlags>$(OtherFlags) --warnon:1182</OtherFlags>   <!-- 1182: warn on unused variables -->
    <ChangelogFile>./CHANGELOG.md</ChangelogFile> <!-- for Ionide.KeepAChangelog.Tasks -->
  </PropertyGroup>

  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <!-- <SymbolPackageFormat>snupkg</SymbolPackageFormat> -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/goswinr/Fesh</PackageProjectUrl>
    <RepositoryUrl>https://github.com/goswinr/Fesh</RepositoryUrl>
    <PackageIcon>logo128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile><!-- using snupkg the readme does not pack https://github.com/NuGet/Home/issues/10791 -->
    <PackageDescription>A hostable cross-platform scripting editor for F#, based on AvaloniaEdit</PackageDescription>
    <PackageTags>Avalonia TextEditor fsharp scripting FSI AvaloniaEdit fesh</PackageTags>

    <!-- to put the dll of the AvaloniaEdit fork into this nuget package, see target below -->
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeAvaloniaEditForkInPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>


  <!-- build the NET core nuget for F#8 so that dependencies like System.Diagnostics.DiagnosticSource are also for net8 and load properly in Rhino and Revit:
  see https://github.com/dotnet/fsharp/issues/19174
  Use Include not Update for FSharp.Core because of DisableImplicitFSharpCoreReference-->
  <ItemGroup Condition="$(TargetFramework.StartsWith('net10.0'))"> <!-- 43.11.x depends on the 10.x versions of System.Diagnostics.DiagnosticSource etc, 43.10.x still on 9.x -->
    <PackageReference Include="FSharp.Compiler.Service" Version="43.11.303" />
    <PackageReference Include="FSharp.Core"             Version="10.1.303" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.StartsWith('net8.0'))">
    <PackageReference Include="FSharp.Compiler.Service" Version="43.8.403" />
    <PackageReference Include="FSharp.Core"             Version="8.0.403" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.StartsWith('net9.0'))">
    <PackageReference Include="FSharp.Compiler.Service" Version="43.9.303" />
    <PackageReference Include="FSharp.Core"             Version="9.0.303" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Velopack" Version="0.0.1298" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.103" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="Ionide.KeepAChangelog.Tasks" Version="0.3.3" PrivateAssets="all" />

    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="MessageBox.Avalonia" Version="12.0.0" />

    <!-- The fork of AvaloniaEdit needs to be on a branch that is built for Avalonia 12 ( 'avalonia12' ).
    Fesh uses features that only this fork has, so the nuget package Avalonia.AvaloniaEdit can't be used instead.
    PrivateAssets="all" keeps the nuget package of Fesh from depending on the package Avalonia.AvaloniaEdit,
    the dll of the fork is put into the package of Fesh instead, see the target IncludeAvaloniaEditForkInPackage below. -->
    <ProjectReference Include="../AvaloniaEdit/src/AvaloniaEdit/AvaloniaEdit.csproj" PrivateAssets="all" />

    <PackageReference Include="Microsoft.VisualBasic" Version="10.3.0" /> <!-- to move files to the recycle bin instead of deleting them -->
  </ItemGroup>

  <ItemGroup>
    <Content Include="README.md" Pack="true" PackagePath="\" />
    <Content Include="Media/logo128.png" Pack="true" PackagePath="\" /> <!--PackagePath = "\" makes the file available to nuget pack tool-->
    <AvaloniaResource Include="Media/logo.ico" />          <!--  for Application Icon in primary windows-->
    <AvaloniaResource Include="Media/logoGray.ico" />      <!--  for Application Icon in secondary PopOut windows-->
    <EmbeddedResource Include="Media/logo.res" />  <!--  for Application Icon in explorer-->

    <Content Include="Src/SyntaxHighlightingFSharp.xshd" CopyToOutputDirectory="PreserveNewest" TargetPath="SyntaxHighlightingFSharp.xshd" Pack="true" PackagePath="\" />

    <!-- keep this list of files the same as in FeshStandalone.fsproj: -->
    <Compile Include="Src/Fittings/Sync.fs" />
    <Compile Include="Src/Fittings/WebBrowser.fs" />
    <Compile Include="Src/Fittings/MessageBox.fs" />
    <Compile Include="Src/Fittings/SafeReadWriter.fs" />
    <Compile Include="Src/Fittings/PersistentSettings.fs" />
    <Compile Include="Src/Fittings/Command.fs" />
    <Compile Include="Src/Fittings/ViewModel.fs" />
    <Compile Include="Src/Fittings/DependencyProps.fs" />
    <Compile Include="Src/Fittings/ErrorHandling.fs" />
    <Compile Include="Src/Fittings/PositionedWindow.fs" />

    <Compile Include="Src/AvaloniaLog/Brush.fs" />
    <Compile Include="Src/AvaloniaLog/Util.fs" />
    <Compile Include="Src/AvaloniaLog/TextColor.fs" />
    <Compile Include="Src/AvaloniaLog/LogTextWriter.fs" />
    <Compile Include="Src/AvaloniaLog/AvaloniaLog.fs" />

    <Compile Include="Src/Util.fs" />
    <Compile Include="Src/ParseFs.fs" />
    <Compile Include="Src/Timer.fs" />
    <Compile Include="Src/StyleState.fs" />
    <Compile Include="Src/Model.fs" />

    <Compile Include="Src/Config/RunContext.fs" />
    <Compile Include="Src/Config/DefaultCode.fs" />
    <Compile Include="Src/Config/ScriptCompilerTemplate.fs" />
    <Compile Include="Src/Config/FsiArguments.fs" />
    <Compile Include="Src/Config/OpenTabs.fs" />
    <Compile Include="Src/Config/RecentlyUsedFiles.fs" />
    <Compile Include="Src/Config/AutoCompleteStatistic.fs" />
    <Compile Include="Src/Config/FoldingStatus.fs" />
    <Compile Include="Src/Config/Config.fs" />

    <Compile Include="Src/Fsi.fs" />
    <Compile Include="Src/CompileScript.fs" />
    <Compile Include="Src/XmlParser.fs" />

    <Compile Include="Src/Editor/AutoFixErrors.fs" />
    <Compile Include="Src/Editor/Selection.fs" />
    <Compile Include="Src/Editor/RectangleSelection.fs" />
    <Compile Include="Src/Editor/SwapWords.fs" />
    <Compile Include="Src/Editor/Commenting.fs" />
    <Compile Include="Src/Editor/ColumnRulers.fs" />
    <Compile Include="Src/Editor/SwapLines.fs" />
    <Compile Include="Src/Editor/CursorBehavior.fs" />
    <Compile Include="Src/Editor/AlignText.fs" />
    <Compile Include="Src/Editor/XshdHighlighting.fs" />
    <Compile Include="Src/Editor/FastColorizer.fs" />
    <Compile Include="Src/Editor/InteractionState.fs" />
    <Compile Include="Src/Editor/ErrorHighlighter.fs" />
    <Compile Include="Src/Editor/TypeInfo.fs" />
    <Compile Include="Src/Editor/Checker.fs" />
    <Compile Include="Src/Editor/Completions.fs" />
    <Compile Include="Src/Editor/Foldings.fs" />
    <Compile Include="Src/Editor/EvaluationTracker.fs" />
    <Compile Include="Src/Editor/SelectionHighlighter.fs" />
    <Compile Include="Src/Editor/SemanticHighlighter.fs" />
    <Compile Include="Src/Editor/BracketHighlighter.fs" />
    <Compile Include="Src/Editor/DocChanged.fs" />
    <Compile Include="Src/Editor/KeyboardShortcuts.fs" />

    <Compile Include="Src/Views/Scrollbar.fs" />
    <Compile Include="Src/Views/Log.fs" />
    <Compile Include="Src/Views/Editor.fs" />
    <Compile Include="Src/Views/FeshWindow.fs" />
    <Compile Include="Src/Views/FileWatcher.fs" />
    <Compile Include="Src/Views/Tab.fs" />
    <Compile Include="Src/Views/Tabs.fs" />
    <Compile Include="Src/Views/TabsAndLog.fs" />
    <Compile Include="Src/Views/Fonts.fs" />
    <Compile Include="Src/Views/StatusBar.fs" />
    <Compile Include="Src/Views/PopOut.fs" />
    <Compile Include="Src/Views/Commands.fs" />
    <Compile Include="Src/Views/Menu.fs" />
    <Compile Include="Src/Views/Fesh.fs" />

    <Compile Include="Src/Initialize.fs" />
    <Compile Include="Src/App.fs" />

  </ItemGroup>

  <!-- Puts AvaloniaEdit.dll of the fork (and its pdb) next to Fesh.dll in the lib folder of the nuget package. -->
  <Target Name="IncludeAvaloniaEditForkInPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths-&gt;WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" />
    </ItemGroup>
  </Target>

  <Target Name="WriteChangelogVersion" AfterTargets="AfterBuild"> <!-- to check output from Ionide.KeepAChangelog.Tasks current git tag in gh actions -->
    <WriteLinesToFile File="./bin/ChangelogVersion.txt" Lines="@(CurrentReleaseChangelog)" Overwrite="true" ContinueOnError="false" />
  </Target>

</Project>
